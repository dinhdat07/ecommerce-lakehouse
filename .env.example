# General
PROJECT_NAME=ecommerce-lakehouse
ENV=local
DEPLOYMENT_PROFILE=local

# Paths
RAW_DATA_DIR=./data/raw
SAMPLE_DATA_DIR=./data/sample
LOCAL_DATA_ROOT=./data/lakehouse
MANIFEST_ROOT=./data/manifests
CHECKPOINT_ROOT=./checkpoints
BENCHMARK_OUTPUT_ROOT=./data/benchmarks
BRONZE_PATH=s3a://bronze/events
SILVER_PATH=s3a://silver/events
GOLD_PATH=s3a://gold/analytics

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=ecom.events
KAFKA_TOPIC_DLQ=ecom.events.dlq
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_TOPIC_MIN_INSYNC_REPLICAS=1
KAFKA_RETENTION_HOURS=12
KAFKA_RETENTION_BYTES=536870912
KAFKA_MESSAGE_MAX_BYTES=2097152

# Streaming / Replay
STREAM_MODE=demo
STREAM_QUERY_NAME=ecommerce-streaming
STREAM_STARTING_OFFSETS=earliest
STREAM_TRIGGER_SECONDS=5
STREAM_MAX_OFFSETS_PER_TRIGGER=2000
STREAM_TIMEOUT_SECONDS=120
STREAM_STOP_AFTER_SECONDS=0
STREAM_PROGRESS_POLL_SECONDS=10
STREAM_CHECKPOINT_LOCATION=./checkpoints/phase2/kafka_to_iceberg
STREAM_PROGRESS_LOG_PATH=
STREAM_FAIL_ON_DATA_LOSS=false
REPLAY_BATCH_SIZE=500
REPLAY_SLEEP_SECONDS=1.0
REPLAY_RUNTIME_SECONDS=0
REPLAY_REPORT_EVERY=1000
REPLAY_REPEAT_INPUT=false
REPLAY_KAFKA_ACKS=all
REPLAY_COMPRESSION_TYPE=none

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_PATH_STYLE_ACCESS=true
S3_BUCKET_BRONZE=bronze
S3_BUCKET_SILVER=silver
S3_BUCKET_GOLD=gold
S3_BUCKET_WAREHOUSE=warehouse

# Spark
SPARK_MASTER=local[*]
SPARK_APP_NAME_PREFIX=ecommerce-lakehouse
SPARK_DEPLOY_MODE=client
SPARK_DRIVER_MEMORY=1400m
SPARK_EXECUTOR_MEMORY=2g
SPARK_SQL_SHUFFLE_PARTITIONS=8
SPARK_LOCAL_DIR=/tmp

# Iceberg
ICEBERG_CATALOG=local_catalog
ICEBERG_CATALOG_TYPE=jdbc
ICEBERG_CATALOG_URI=jdbc:postgresql://postgres:5432/iceberg
ICEBERG_CATALOG_USER=iceberg
ICEBERG_CATALOG_PASSWORD=iceberg
ICEBERG_CATALOG_DRIVER=org.postgresql.Driver
ICEBERG_WAREHOUSE=s3a://warehouse

# Trino / Superset (placeholders)
TRINO_HOST=localhost
TRINO_PORT=8080
SUPERSET_URL=http://localhost:8088

# Server-ready profiles
# - local/demo defaults stay in this file
# - use infra/local/env/local.env.example for the laptop stack
# - use infra/server/env/server.env.example plus storage and benchmark env files for server/full-scale deployment
