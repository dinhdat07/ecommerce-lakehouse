# Copy to infra/server/env/minio-nginx.env on every Nginx ingress node.

MINIO_NGINX_API_UPSTREAMS=34.158.41.81:9100,34.87.25.115:9100,34.21.161.216:9100
MINIO_NGINX_CONSOLE_UPSTREAMS=34.158.41.81:9101,34.87.25.115:9101,34.21.161.216:9101

MINIO_NGINX_SERVER_NAME=minio.example.com
MINIO_NGINX_CONSOLE_SERVER_NAME=minio-console.example.com
MINIO_NGINX_API_PORT=9000
MINIO_NGINX_CONSOLE_PORT=9001
MINIO_NGINX_ENABLE_CONSOLE=true

# Set true when TLS certs are mounted at MINIO_NGINX_CERT_DIR.
MINIO_NGINX_TLS_ENABLED=false
MINIO_NGINX_CERT_DIR=/srv/ecommerce/certs/minio
MINIO_NGINX_TLS_CERT_FILE=/etc/nginx/certs/tls.crt
MINIO_NGINX_TLS_KEY_FILE=/etc/nginx/certs/tls.key
