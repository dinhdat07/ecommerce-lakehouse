# Copy to infra/server/env/server.env before using server scripts.
DEPLOYMENT_PROFILE=server
ENV=server
STREAM_MODE=server

PROJECT_NAME=ecommerce-lakehouse
RAW_DATA_DIR=/srv/ecommerce/raw
SAMPLE_DATA_DIR=/srv/ecommerce/sample
LOCAL_DATA_ROOT=/srv/ecommerce/lakehouse
MANIFEST_ROOT=/srv/ecommerce/manifests
CHECKPOINT_ROOT=/srv/ecommerce/checkpoints
BENCHMARK_OUTPUT_ROOT=/srv/ecommerce/benchmarks

KAFKA_BOOTSTRAP_SERVERS=server-kafka-1:9092,server-kafka-2:9092,server-kafka-3:9092
KAFKA_CONTROLLER_QUORUM_VOTERS=1@server-kafka-1:9093,2@server-kafka-2:9093,3@server-kafka-3:9093
KAFKA_TOPIC_EVENTS=ecom.events
KAFKA_TOPIC_DLQ=ecom.events.dlq
KAFKA_TOPIC_PARTITIONS=12
KAFKA_TOPIC_REPLICATION_FACTOR=3
KAFKA_TOPIC_MIN_INSYNC_REPLICAS=2
KAFKA_RETENTION_HOURS=72
KAFKA_RETENTION_BYTES=10737418240
KAFKA_MESSAGE_MAX_BYTES=4194304

SPARK_MASTER=spark://100.73.230.102:7077
SPARK_DEPLOY_MODE=client
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=1g
SPARK_SQL_SHUFFLE_PARTITIONS=8
SPARK_LOCAL_DIR=/srv/ecommerce/spark-tmp

STREAM_QUERY_NAME=ecommerce-streaming
STREAM_STARTING_OFFSETS=latest
STREAM_TRIGGER_SECONDS=10
STREAM_MAX_OFFSETS_PER_TRIGGER=50000
STREAM_TIMEOUT_SECONDS=0
STREAM_STOP_AFTER_SECONDS=0
STREAM_PROGRESS_POLL_SECONDS=15
STREAM_CHECKPOINT_LOCATION=/srv/ecommerce/checkpoints/streaming/ecommerce-streaming
STREAM_PROGRESS_LOG_PATH=/srv/ecommerce/logs/streaming/ecommerce-streaming-progress.jsonl
STREAM_FAIL_ON_DATA_LOSS=true
STREAM_GOLD_REFRESH_MODE=full

REPLAY_BATCH_SIZE=5000
REPLAY_SLEEP_SECONDS=0.25
REPLAY_RUNTIME_SECONDS=0
REPLAY_REPORT_EVERY=5000
REPLAY_REPEAT_INPUT=false
REPLAY_KAFKA_ACKS=all
REPLAY_COMPRESSION_TYPE=lz4

# Point this at the stable MinIO ingress endpoint. For self-hosted server mode,
# prefer the cloud load balancer or Nginx VIP rather than a single storage node.
S3_ENDPOINT=https://minio-cluster.example.com
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_REGION=us-east-1
S3_PATH_STYLE_ACCESS=true
S3_BUCKET_BRONZE=bronze
S3_BUCKET_SILVER=silver
S3_BUCKET_GOLD=gold
S3_BUCKET_WAREHOUSE=warehouse

BRONZE_PATH=s3a://bronze/events
SILVER_PATH=s3a://silver/events
GOLD_PATH=s3a://gold/analytics

ICEBERG_CATALOG=lakehouse
ICEBERG_CATALOG_TYPE=jdbc
ICEBERG_CATALOG_URI=jdbc:postgresql://100.73.230.102:5432/iceberg
ICEBERG_CATALOG_USER=iceberg
ICEBERG_CATALOG_PASSWORD=iceberg
ICEBERG_CATALOG_DRIVER=org.postgresql.Driver
ICEBERG_WAREHOUSE=s3://warehouse

TRINO_NODE_ENVIRONMENT=server
TRINO_NODE_ID=server-trino-1
TRINO_CATALOG_NAME=lakehouse
TRINO_HTTP_PORT=8080

SPARK_SUBMIT_BIN=spark-submit
SPARK_IVY_DIR=/tmp/.ivy2
SPARK_ICEBERG_PACKAGES=org.apache.iceberg:iceberg-spark-runtime-3.5_2.12:1.6.1,org.apache.iceberg:iceberg-aws-bundle:1.6.1,org.postgresql:postgresql:42.7.3
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1
SERVER_RUNTIME_DIR=/srv/ecommerce/runtime
SERVER_COMPOSE_PROJECT_NAME=ecommerce-lakehouse-server
