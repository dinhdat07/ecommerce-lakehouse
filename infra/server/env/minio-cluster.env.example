# Copy to infra/server/env/minio-cluster.env on each MinIO node.
# Keep MINIO_CLUSTER_VOLUMES identical on every node. Update only local bind paths if needed.

MINIO_DATA_DIR=/srv/minio/data1
MINIO_API_BIND_PORT=9100
MINIO_CONSOLE_BIND_PORT=9101
MINIO_CLUSTER_VOLUMES="http://34.158.41.81:9100/data1 http://34.87.25.115:9100/data1 http://34.21.161.216:9100/data1"

# Optional external URLs if you terminate TLS at Nginx or a cloud load balancer.
MINIO_SERVER_URL=https://minio.example.com
MINIO_BROWSER_REDIRECT_URL=https://minio-console.example.com
