BENCHMARK_MODE=full
BENCHMARK_INPUT_DIR=/srv/ecommerce/raw
BENCHMARK_OUTPUT_ROOT=/srv/ecommerce/benchmarks
BENCHMARK_RUN_LABEL=
BENCHMARK_PARQUET_WAREHOUSE=s3a://warehouse/benchmarks/parquet
BENCHMARK_SUBSET_ENABLED=true
BENCHMARK_SUBSET_MODE=fraction
BENCHMARK_START_MONTH=2019-10
BENCHMARK_END_MONTH=2019-10
STREAM_BENCHMARK_START_MONTH=2019-10
STREAM_BENCHMARK_END_MONTH=2019-10
BENCHMARK_SAMPLE_FRACTION=0.001
BENCHMARK_SAMPLE_SEED=42
BENCHMARK_CACHE_DATAFRAMES=false
BENCHMARK_STAGING_ENABLED=true
STREAM_BENCHMARK_INPUT_DIR=/srv/ecommerce/raw
STREAM_BENCHMARK_MICROBATCH_SIZE=10000
SPARK_EXTRA_PACKAGES=org.apache.hadoop:hadoop-aws:3.3.4
SPARK_EXECUTOR_CORES=1
SPARK_DEFAULT_PARALLELISM=4
SPARK_DRIVER_MAX_RESULT_SIZE=512m
SPARK_SQL_ADAPTIVE_ENABLED=true
SPARK_SQL_ADAPTIVE_COALESCE_PARTITIONS_ENABLED=true
SPARK_SQL_ADAPTIVE_ADVISORY_PARTITION_SIZE=32m
SPARK_SQL_FILES_MAX_PARTITION_BYTES=64m
SPARK_SQL_FILES_OPEN_COST_BYTES=4194304
SPARK_SQL_PARQUET_VECTORIZED_READER=true
SPARK_SQL_PARQUET_FILTER_PUSHDOWN=true
SPARK_LOCAL_DIR=/srv/ecommerce/spark-tmp
SPARK_SQL_SHUFFLE_PARTITIONS=4
BENCHMARK_SPARK_CLEANUP_HOSTS="100.120.253.14 100.99.13.51"
BENCHMARK_DISK_WATCHDOG_THRESHOLD_PCT=90
BENCHMARK_DISK_WATCHDOG_INTERVAL_SECONDS=30
