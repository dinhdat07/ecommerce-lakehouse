# Benchmark wrapper defaults. BENCHMARK_PROFILE is first-class and defaults to smoke.
# Profiles: smoke (~0.001), simple-small (~0.025), simple-medium (~0.05-0.10), stress-lite (~0.25-0.35),
# profile_2month_batch_streaming_sample (2019-10..2019-11 full batch + sampled 2019-12 streaming), full (requires BENCHMARK_ALLOW_FULL=true).
BENCHMARK_PROFILE=smoke
BENCHMARK_MODE=full
BENCHMARK_INPUT_DIR=/srv/ecommerce/raw
STREAM_BENCHMARK_INPUT_DIR=/srv/ecommerce/raw
BENCHMARK_SAMPLE_FILE=/opt/ecommerce-lakehouse/data/sample/events_sample_100k.csv
STREAM_BENCHMARK_SAMPLE_FILE=/opt/ecommerce-lakehouse/data/sample/events_streaming_demo_1500.csv
BENCHMARK_OUTPUT_ROOT=/srv/ecommerce/benchmarks
BENCHMARK_RUN_LABEL=
BENCHMARK_PARQUET_WAREHOUSE=
BENCHMARK_STAGING_ROOT=
BENCHMARK_INPUT_SAMPLE_ENABLED=true
BENCHMARK_INPUT_SAMPLE_ROOT=s3a://warehouse/benchmarks/input_samples
BENCHMARK_INPUT_SAMPLE_BOOTSTRAP_PATH=
BENCHMARK_INPUT_ROW_COUNT_OVERRIDE=
BENCHMARK_SUBSET_ENABLED=true
BENCHMARK_SUBSET_MODE=fraction
BENCHMARK_START_MONTH=2019-10
BENCHMARK_END_MONTH=2019-10
STREAM_BENCHMARK_START_MONTH=2019-10
STREAM_BENCHMARK_END_MONTH=2019-10
BENCHMARK_SAMPLE_FRACTION=0.001
BENCHMARK_SAMPLE_SEED=42
PROFILE_2MONTH_STREAM_SAMPLE_FRACTION=0.10
SYSTEM_BENCHMARK_SUBSET_ENABLED=
SYSTEM_BENCHMARK_SUBSET_MODE=
SYSTEM_BENCHMARK_SAMPLE_FRACTION=
STREAM_BENCHMARK_SUBSET_ENABLED=
STREAM_BENCHMARK_SUBSET_MODE=
STREAM_BENCHMARK_SAMPLE_FRACTION=
BENCHMARK_PARQUET_BASELINE_ENABLED=true
SYSTEM_GOLD_REFRESH_MODE=full
PROCESSING_BATCH_ENABLED=true
STREAM_BENCHMARK_CHECKPOINT_LOCATION=
BENCHMARK_CACHE_DATAFRAMES=false
BENCHMARK_STAGING_ENABLED=true
STREAM_BENCHMARK_MICROBATCH_SIZE=50000
PROCESSING_GOLD_REFRESH_MODE=affected_dates
BENCHMARK_CLEANUP_SPARK_TEMP_BEFORE=true
BENCHMARK_DISK_WATCHDOG_THRESHOLD_PCT=90
BENCHMARK_DISK_FREE_THRESHOLD_GB=20
BENCHMARK_DISK_WATCHDOG_INTERVAL_SECONDS=30
ICEBERG_WRITE_DISTRIBUTION_MODE=hash
ICEBERG_WRITE_TARGET_FILE_SIZE_BYTES=134217728
